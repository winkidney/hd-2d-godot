    cloud["CloudPhase<br/>风速积分 / 不重算历史位移"]
    render["单一 Forward+ 视口<br/>五层装饰补偿 / 近场不移动"]
    tests["独立验收与发布门禁<br/>像素位移 / 设置恢复 / 运行指纹"]
    camera --> controller
    origin --> controller
    settings --> profile
    profile --> controller
    settings --> cloud
    controller --> render
    cloud --> render
