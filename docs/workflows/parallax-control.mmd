flowchart TD
    camera["CameraRig<br/>最终相机姿态 / 固定参考轴"]
    settings["F8 / Local settings<br/>白名单校验 / 显式保存"]
    origin["LayerState<br/>原始世界变换 / 无累积漂移"]
    profile["ParallaxProfile<br/>Natural / Artistic / 有效倍率"]
